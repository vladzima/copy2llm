{
  "name": "copy2llm-core",
  "version": "0.2.0",
  "type": "module",
  "description": "Turn a live DOM into clean Markdown.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "bun test",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.0",
    "@types/turndown": "^5.0.0",
    "bun-types": "^1.3.0",
    "jsdom": "^25.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "homepage": "https://copy.computer",
  "bugs": {
    "url": "https://github.com/vladzima/copy2llm/issues"
  },
  "keywords": [
    "markdown",
    "llm",
    "copy-to-llm",
    "extract",
    "readability",
    "turndown",
    "chatgpt",
    "claude",
    "html-to-markdown"
  ],
  "author": "Vlad Arbatov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladzima/copy2llm.git",
    "directory": "packages/core"
  }
}
