{
  "name": "@copy2llm/widget",
  "version": "0.0.0",
  "type": "module",
  "description": "The Copy to LLM button — a themeable split-button widget in a Shadow DOM.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "bun test",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@copy2llm/core": "workspace:*"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.0",
    "bun-types": "^1.3.0",
    "jsdom": "^25.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
