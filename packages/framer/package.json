{
  "name": "copy2llm-framer",
  "version": "0.2.1",
  "type": "module",
  "description": "Copy to LLM as a Framer code component, configured from the property panel.",
  "license": "MIT",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "bun test",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "copy2llm-react": "workspace:*"
  },
  "peerDependencies": {
    "framer": "*",
    "react": ">=17"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "bun-types": "^1.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
